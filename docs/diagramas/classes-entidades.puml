@startuml classes-entidades
' Diagrama de classes de projeto (1/3) — entidades (camada de modelo).
' Notação dos slides "Diagrama de Classes" (INF01127):
'   atributo: [visibilidade] nome [multiplicidade] : tipo [= valor inicial] [{propriedades}]
'   operação: [visibilidade] nome (parâmetros) : tipo de retorno
'   /nome = atributo derivado; {frozen} = não muda depois de criado; itálico = classe abstrata.
' Fonte: contas/, catalogo/, estoque/ e vendas/models.py.

title Lojinha do DACOMP — Diagrama de classes de projeto (1/3): entidades

skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 12
skinparam packageStyle rectangle
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam packageBorderColor #555555
skinparam arrowColor #333333
skinparam nodesep 45
skinparam ranksep 60
hide empty members
hide circle

package "contas" {
  abstract class AbstractUser <<Django>> {
    + username : Texto {único, máx. 150}
    + first_name : Texto {máx. 150}
    + last_name : Texto {máx. 150}
    + email : Texto
    + is_active : Booleano = verdadeiro
    + is_superuser : Booleano = falso
    + check_password (senha : Texto) : Booleano
    + set_password (senha : Texto)
  }
  class Usuario {
    + /nomes_perfis [0..3] : Texto
    + get_full_name () : Texto
  }
  class Perfil <<Django Group>> {
    + name : Texto {único, frozen}
  }
  AbstractUser <|-- Usuario
  Usuario "0..* membros" --> "0..3 groups" Perfil : possui >
}

package "catalogo" {
  class Produto {
    + codigo : Texto {único, máx. 20}
    + nome : Texto {máx. 120}
    + categoria : Categoria = OUTRO
    + descricao [0..1] : Texto
    + marca [0..1] : Texto {máx. 60}
    + fornecedor [0..1] : Texto {máx. 120}
    + codigo_barras [0..1] : Texto {único, máx. 50}
    + unidade : Unidade = UN
    {field} + preco_unitario : Decimal(8,2) {>= 0}
    {field} + preco_custo [0..1] : Decimal(8,2) {>= 0}
    + ativo : Booleano = verdadeiro
    + controla_estoque : Booleano = verdadeiro
    + saldo_estoque : Inteiro = 0 {>= 0, alterado só por Movimentacao}
    + criado_em : DataHora {frozen}
    + alterado_em : DataHora
    + /lucro_unitario [0..1] : Decimal
    + /margem_percentual [0..1] : Decimal
    + get_absolute_url () : Texto
  }
  enum Categoria <<enumeration>> {
    CAFE
    BEBIDA
    LANCHE
    DOCE
    OUTRO
  }
  enum Unidade <<enumeration>> {
    UN
    COPO
    FATIA
    PCT
    CX
    DZ
    KG
    L
  }
}

package "estoque" {
  class Movimentacao {
    + tipo : TipoMovimentacao {frozen}
    + quantidade_anterior : Inteiro {>= 0, frozen}
    + variacao : Inteiro {frozen}
    + quantidade_resultante : Inteiro {>= 0, frozen}
    + motivo [0..1] : MotivoAjuste {frozen, obrigatório se tipo = AJUSTE}
    + observacao [0..1] : Texto {máx. 255, frozen}
    + realizada_em : DataHora {frozen}
    + get_absolute_url () : Texto
  }
  enum TipoMovimentacao <<enumeration>> {
    ENTRADA
    AJUSTE
    VENDA
    DEVOLUCAO
  }
  enum MotivoAjuste <<enumeration>> {
    PERDA
    VENCIMENTO
    AVARIA
    CONTAGEM
    OUTRO
  }
}

package "vendas" {
  class Caixa {
    + situacao : SituacaoCaixa = ABERTO {no máximo um ABERTO}
    {field} + valor_inicial : Decimal(10,2) {>= 0, frozen}
    + aberto_em : DataHora {frozen}
    + fechado_em [0..1] : DataHora
    {field} + valor_esperado [0..1] : Decimal(10,2)
    {field} + valor_contado [0..1] : Decimal(10,2) {>= 0}
    + justificativa [0..1] : Texto {máx. 255, obrigatória se houver diferença}
    + /diferenca [0..1] : Decimal
  }
  class Venda {
    + situacao : SituacaoVenda = EM_ANDAMENTO
    + iniciada_em : DataHora {frozen}
    + concluida_em [0..1] : DataHora
    {field} + total : Decimal(10,2) = 0
    + forma_pagamento [0..1] : FormaPagamento
    {field} + valor_recebido [0..1] : Decimal(10,2)
    {field} + troco [0..1] : Decimal(10,2)
    + /total_itens : Decimal
    + /total_devolvido : Decimal
    + /total_liquido : Decimal
    + get_absolute_url () : Texto
  }
  class ItemVenda {
    + quantidade : Inteiro {> 0}
    {field} + preco_unitario : Decimal(8,2) {frozen, preço praticado na venda}
    + /subtotal : Decimal
    + /quantidade_devolvida : Inteiro
    + /quantidade_devolvivel : Inteiro
  }
  class Devolucao {
    + motivo : Texto {máx. 255, frozen}
    + forma_estorno : FormaPagamento {frozen, = forma de pagamento da venda}
    {field} + valor_estornado : Decimal(10,2) {> 0, frozen}
    + realizada_em : DataHora {frozen}
    + get_absolute_url () : Texto
  }
  class ItemDevolucao {
    + quantidade : Inteiro {> 0, <= quantidade devolvível, frozen}
    + /subtotal : Decimal
  }
  enum SituacaoCaixa <<enumeration>> {
    ABERTO
    FECHADO
  }
  enum SituacaoVenda <<enumeration>> {
    EM_ANDAMENTO
    CONCLUIDA
    CANCELADA
  }
  enum FormaPagamento <<enumeration>> {
    DINHEIRO
    PIX
  }
}

' Posicionamento (links invisíveis, só para o layout).
Categoria -[hidden]right- Unidade
Produto -[hidden]down- Categoria
TipoMovimentacao -[hidden]right- MotivoAjuste
Movimentacao -[hidden]down- TipoMovimentacao
SituacaoCaixa -[hidden]right- SituacaoVenda
SituacaoVenda -[hidden]right- FormaPagamento

' Associações: "multiplicidade papel" em cada extremidade e nome no meio.
' Com seta: navegável só no sentido da seta. Sem seta: navegável nos dois sentidos.
Caixa "1 caixa" -- "0..* vendas" Venda : registra >
Caixa "1 caixa" -- "0..* devolucoes" Devolucao : estorna >
Venda "1 venda" -- "0..* devolucoes" Devolucao : tem >

' Composição: os itens só existem dentro da venda / devolução e são excluídos com ela.
Venda "1 venda" *-- "0..* itens" ItemVenda : compõe <
ItemVenda "0..*" --> "1 produto" Produto : refere-se a >
Devolucao "1 devolucao" *-- "1..* itens" ItemDevolucao : compõe <
ItemDevolucao "0..* devolucoes" -- "1 item_venda" ItemVenda : devolve >

Movimentacao "0..*" --> "1 produto" Produto : altera saldo de >

Produto "0..*" --> "1 criado_por\n1 alterado_por" Usuario : cadastrado por >
Movimentacao "0..*" --> "1 responsavel" Usuario : registrada por >
Caixa "0..*" --> "1 aberto_por\n0..1 fechado_por" Usuario : operado por >
Venda "0..*" --> "1 operador" Usuario : atendida por >
Devolucao "0..*" --> "1 operador" Usuario : registrada por >

note bottom of ItemVenda
  {único: venda + produto}
  Repetir o produto soma à quantidade.
end note
note bottom of ItemDevolucao
  {único: devolucao + item_venda}
end note

@enduml
