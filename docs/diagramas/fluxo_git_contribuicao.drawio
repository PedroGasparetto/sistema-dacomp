  <diagram id="fluxo-git-contribuicao" name="Fluxo de Contribuição Git">
    <mxGraphModel dx="1220" dy="260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1220" pageHeight="200" background="#ffffff" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="g1" value="1. Atualizar main&#xa;(git pull origin main)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="30" y="65" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g2" value="2. Criar branch&#xa;(feat/... ou fix/...)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="65" width="160" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g3" value="3. Implementar em camadas&#xa;+ Escrever testes" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="65" width="175" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g4" value="4. Rodar pytest&#xa;(docker compose exec web pytest)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="645" y="65" width="185" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g5" value="5. Commit e Push&#xa;(mensagens claras)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="870" y="65" width="150" height="60" as="geometry" />
        </mxCell>
        <mxCell id="g6" value="6. Abrir Pull Request&#xa;para main" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1060" y="65" width="140" height="60" as="geometry" />
        </mxCell>

        <mxCell id="ge1" style="endArrow=classic;html=1;" edge="1" parent="1" source="g1" target="g2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge2" style="endArrow=classic;html=1;" edge="1" parent="1" source="g2" target="g3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge3" style="endArrow=classic;html=1;" edge="1" parent="1" source="g3" target="g4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge4" style="endArrow=classic;html=1;" edge="1" parent="1" source="g4" target="g5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="ge5" style="endArrow=classic;html=1;" edge="1" parent="1" source="g5" target="g6"><mxGeometry relative="1" as="geometry" /></mxCell>
