# Copie para .env e ajuste os valores.
# Desenvolvimento (docker-compose.yml): só as credenciais do PostgreSQL são usadas.
# Rede local do DA (docker-compose.rede-local.yml): preencha também as variáveis do Django.
POSTGRES_DB=lojinha
POSTGRES_USER=lojinha
POSTGRES_PASSWORD=troque-esta-senha

# Chave secreta longa e aleatória. Para gerar uma:
#   docker run --rm python:3.13-slim python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Endereços pelos quais os computadores acessam o sistema: o IP fixo do computador
# servidor na rede do DA e o nome dele, separados por vírgula.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.10

# Porta aberta na rede (o endereço fica http://IP:PORTA).
PORTA=8000

# Duração do turno de atendimento, em minutos: ao fim dele, é preciso entrar de novo.
DURACAO_TURNO_MINUTOS=100
